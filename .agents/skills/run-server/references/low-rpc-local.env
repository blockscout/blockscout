# Low-RPC local indexing profile.
#
# Purpose: index a real network from a local machine with as few JSON-RPC
# requests as possible (to stay under provider rate limits) and with low local
# resource use. The profile keeps the block import pipeline: blocks,
# transactions, receipts, logs, token transfers. Background fetchers that
# enrich data later are disabled.
#
# Append CHAIN_TYPE, DATABASE_URL and ETHEREUM_JSONRPC_HTTP_URL (see Step 1 of
# SKILL.md). Every variable below was checked against config/runtime.exs,
# config/runtime/dev.exs and apps/indexer/config/{dev,prod}/<variant>.exs.

# --- Node ---
# Set to the actual node client (geth, nethermind, erigon, besu, ...).
ETHEREUM_JSONRPC_VARIANT=geth
# Empty trace URL also disables archive balance requests.
ETHEREUM_JSONRPC_TRACE_URL=
# One eth_getBlockReceipts call per block instead of one call per transaction.
# Remove this line if the node or provider does not support eth_getBlockReceipts.
ETHEREUM_JSONRPC_RECEIPTS_BY_BLOCK=true

# --- Block import pace and parallelism ---
# Pause between catch-up rounds (read by the variant config, default 0s).
INDEXER_CATCHUP_BLOCK_INTERVAL=2s
INDEXER_CATCHUP_BLOCKS_BATCH_SIZE=10
INDEXER_CATCHUP_BLOCKS_CONCURRENCY=2
INDEXER_RECEIPTS_BATCH_SIZE=10
INDEXER_RECEIPTS_CONCURRENCY=1

# --- Background fetchers not needed for block/transaction/log import ---
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
INDEXER_DISABLE_ADDRESS_COIN_BALANCE_FETCHER=true
INDEXER_DISABLE_ARCHIVAL_TOKEN_BALANCES_FETCHER=true
INDEXER_DISABLE_CURRENT_TOKEN_BALANCES_FETCHER=true
INDEXER_DISABLE_TOKEN_BALANCE_ON_DEMAND_FETCHER=true
INDEXER_DISABLE_TOKEN_TOTAL_SUPPLY_ON_DEMAND_FETCHER=true
INDEXER_DISABLE_TOKEN_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_REALTIME_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_RETRY_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_SANITIZE_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_REFETCH_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_ERC_1155_SANITIZE_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_ERC_721_SANITIZE_FETCHER=true
INDEXER_DISABLE_TOKEN_INSTANCE_MEDIA_TYPE_FETCHER=true
INDEXER_DISABLE_TOKEN_UI_MULTIPLIER_UPDATER_FETCHER=true
INDEXER_DISABLE_CATALOGED_TOKEN_UPDATER_FETCHER=true
INDEXER_DISABLE_CONTRACT_CODE_FETCHER=true
INDEXER_DISABLE_SIGNED_AUTHORIZATION_STATUS_FETCHER=true
INDEXER_DISABLE_UNCLE_BLOCK_FETCHER=true
INDEXER_DISABLE_UNCLES_WITHOUT_INDEX_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_SANITIZER=true
INDEXER_DISABLE_REPLACED_TRANSACTION_FETCHER=true
INDEXER_DISABLE_EMPTY_BLOCKS_SANITIZER=true
INDEXER_DISABLE_BEACON_BLOB_FETCHER=true
INDEXER_DISABLE_HOT_SMART_CONTRACTS_FETCHER=true

# --- Local resources: database, memory, external services ---
POOL_SIZE=20
POOL_SIZE_API=10
INDEXER_MEMORY_LIMIT=6gb
DISABLE_MARKET=true
SOURCIFY_INTEGRATION_ENABLED=false
MICROSERVICE_SC_VERIFIER_ENABLED=false
TXS_STATS_ENABLED=false
INDEXER_METRICS_ENABLED=false
MIGRATION_HEAVY_INDEX_OPERATIONS_CHECK_INTERVAL=20s
