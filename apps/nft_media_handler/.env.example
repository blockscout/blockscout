# Example env file for nft_media_handler (DO NOT commit secrets)
# Copy to .env and fill real values before running.

# Runtime
NFT_MEDIA_HANDLER_ENABLED=true
NFT_MEDIA_HANDLER_IS_WORKER=true
PORT=4000
SECRET_KEY_BASE=replace_with_secret_key_base

# R2 / S3-compatible credentials
NFT_MEDIA_HANDLER_AWS_ACCESS_KEY_ID=your_r2_access_key
NFT_MEDIA_HANDLER_AWS_SECRET_ACCESS_KEY=your_r2_secret
NFT_MEDIA_HANDLER_AWS_BUCKET_HOST=your_account_id.r2.cloudflarestorage.com
NFT_MEDIA_HANDLER_AWS_BUCKET_NAME=your_bucket_name
NFT_MEDIA_HANDLER_AWS_PUBLIC_BUCKET_URL=https://your_account_id.r2.cloudflarestorage.com/your_bucket_name

# Optional tuning
NFT_MEDIA_HANDLER_WORKER_CONCURRENCY=10
NFT_MEDIA_HANDLER_WORKER_BATCH_SIZE=10
NFT_MEDIA_HANDLER_BUCKET_FOLDER=nft_media
