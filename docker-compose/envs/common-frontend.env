# Shared between every Coolify deployment that loads this file (coolify.yml,
# coolify-source-build.yml, ...). Each deployment points these at its OWN
# backend/stats/visualizer — hardcoding one deployment's domain here would
# make every OTHER deployment sharing this file silently call the wrong
# instance. BACKEND_HOST/EXPLORER_HOST/STATS_HOST/VISUALIZER_HOST are plain
# Compose variable substitution (works inside env_file as of Compose v2.24+),
# resolved from whatever env vars the deploying Coolify resource sets — with
# today's metrixchain.com production domains as the default when unset, so
# production needs no changes.
NEXT_PUBLIC_API_HOST=${BACKEND_HOST:-backend.metrixchain.com}
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_APP_HOST=${EXPLORER_HOST:-explorer.metrixchain.com}
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_STATS_API_HOST=https://${STATS_HOST:-stats.metrixchain.com}
NEXT_PUBLIC_VISUALIZE_API_HOST=https://${VISUALIZER_HOST:-visualizer.metrixchain.com}
NEXT_PUBLIC_NETWORK_NAME=MetrixChain
NEXT_PUBLIC_NETWORK_SHORT_NAME=MetrixChain
NEXT_PUBLIC_NETWORK_ID=1337
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Metrix
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=MTX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_IS_TESTNET=false
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml
# Required to enable blockchain interaction
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Disable third-party ads (banner + text/"Sponsored" ads).
# NEXT_PUBLIC_AD_BANNER_ADDITIONAL_PROVIDER only accepts "adbutler", so it is
# left unset to keep the additional banner slot off.
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none
